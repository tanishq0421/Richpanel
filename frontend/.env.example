# ════════════════════════════════════════════════════════════════════════════
# Richpanel FRONTEND — environment template
# ════════════════════════════════════════════════════════════════════════════
#
#   cp frontend/.env.example frontend/.env
#   docker compose --profile frontend up --build
#
# `frontend/.env` is git-ignored and MUST NEVER be committed. This file is the
# committed, documented template.
#
# The backend has its OWN file at backend/.env. Nothing here is shared with it,
# and — importantly — nothing here is secret: every value below is compiled into
# a bundle that any user can read in their browser. NEVER put an API key,
# password, or database URL in this file.
# ════════════════════════════════════════════════════════════════════════════


# ── API location ─────────────────────────────────────────────────────────────
# The base URL of the backend API, as reached FROM THE USER'S BROWSER — not from
# inside the Docker network. This is why it is `localhost:8000` and not
# `http://backend:8000`: the Compose service name only resolves between
# containers, and the browser is outside that network.
#
# ⚠ The `VITE_` prefix is mandatory. Vite only exposes variables that start with
#   VITE_ to client code; a plain APP_BASE_URL would silently be `undefined` in
#   the bundle at runtime.
#
# ⚠ Vite inlines this at BUILD time, so it is baked into the static assets. A
#   production image built for one environment cannot be re-pointed by changing
#   this variable — it must be rebuilt, or served through a runtime-config
#   approach. (Flagged as an open decision in the frontend implementation plan.)
#
# This origin must also appear in CORS_ALLOWED_ORIGINS in backend/.env, or the
# browser will block every response.
VITE_APP_BASE_URL=http://localhost:8000


# ── Timezone ─────────────────────────────────────────────────────────────────
# Container system timezone, kept aligned with the backend so log timestamps
# agree. The application's business timezone is IST and is fixed in backend code
# (see backend/app/domain/types.py) — the UI renders whatever the API returns.
TZ=Asia/Kolkata
