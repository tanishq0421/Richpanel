# ════════════════════════════════════════════════════════════════════════════
# Richpanel BACKEND — environment template
# ════════════════════════════════════════════════════════════════════════════
#
#   cp backend/.env.example backend/.env
#   docker compose up --build
#
# `backend/.env` is git-ignored and MUST NEVER be committed. This file is the
# committed, documented template.
#
# Compose loads this file via `env_file:` for BOTH the `postgres` and `backend`
# services — the database credentials and the backend's connection string are
# two views of the same thing, so they live together and cannot drift apart.
#
# The frontend has its OWN file at frontend/.env — nothing here is visible to it.
# ════════════════════════════════════════════════════════════════════════════


# ── Postgres (consumed by the `postgres` service's official entrypoint) ──────
# On FIRST boot these initialise the cluster and are written into the named
# volume `richpanel_pgdata`. Changing them later does NOT re-initialise an
# existing volume — remove it for new credentials to take effect:
#   docker compose down && docker volume rm richpanel_pgdata
POSTGRES_USER=richpanel
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=richpanel


# ── Application database connection (read by backend/app/db.py) ──────────────
# SQLAlchemy 2.0 + psycopg3 URL. Host is `postgres` — the Compose service name —
# because the backend reaches the DB over the Compose network, not localhost.
#
# The credentials here MUST match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# above. They are kept separate (rather than composed) so that pointing at an
# external managed database is a one-line change.
#
# To run the backend on the HOST against the containerised Postgres instead:
#   postgresql+psycopg://richpanel:change_me_local_only@localhost:55432/richpanel
DATABASE_URL=postgresql+psycopg://richpanel:change_me_local_only@postgres:5432/richpanel


# ── Backend runtime ──────────────────────────────────────────────────────────
# Number of uvicorn worker processes. Rule of thumb (2 x cores) + 1, capped by
# the SQLAlchemy pool (pool_size=10, max_overflow=5 PER WORKER in app/db.py), so
# keep workers x 15 below Postgres' max_connections (default 100).
UVICORN_WORKERS=2

# uvicorn server log level: critical | error | warning | info | debug | trace.
# NOTE: this is the *uvicorn* level only. The application's own JSON logger is
# pinned to INFO in backend/app/logging_config.py and does not read this.
LOG_LEVEL=info

# Public base URL this API is reachable at. Used for absolute-URL generation.
APP_BASE_URL=http://localhost:8000


# ── CORS ─────────────────────────────────────────────────────────────────────
# The frontend runs as its OWN container on its OWN port, so every browser call
# to this API is cross-origin and MUST be allowed here explicitly. Without this
# the UI cannot talk to the API at all — the browser blocks the response before
# any application code sees it.
#
# Comma-separated list of exact origins (scheme + host + port, no trailing
# slash). Wildcards are not used: credentialed requests cannot use "*", and
# enumerating origins is the safer default for a tool holding operational data.
#
# Add the real UI origin per environment, e.g.
#   CORS_ALLOWED_ORIGINS=https://schedules.richpanel.example
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ── Timezone ─────────────────────────────────────────────────────────────────
# Container system timezone (glibc TZ), so container clocks and log timestamps
# agree with the business timezone.
#
# NOTE: the application's BUSINESS timezone is deliberately NOT configurable —
# backend/app/domain/types.py pins it as a hard constant:
#     IST = ZoneInfo("Asia/Kolkata")
# Every schedule weekday/offset and every ticket window is interpreted in that
# zone regardless of TZ. Changing TZ will not move the business logic.
TZ=Asia/Kolkata
